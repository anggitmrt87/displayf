{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3, "minor": 21, "patch": 0
  },
  "configurePresets": [
    {
      "name": "android-arm64",
      "displayName": "Android arm64-v8a",
      "generator": "Ninja",
      "binaryDir": "build/arm64",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{ANDROID_NDK_HOME}/build/cmake/android.toolchain.cmake",
        "ANDROID_ABI": "arm64-v8a",
        "ANDROID_PLATFORM": "android-30",
        "ANDROID_STL": "c++_static",
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "android-arm32",
      "displayName": "Android armeabi-v7a",
      "generator": "Ninja",
      "binaryDir": "build/arm32",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{ANDROID_NDK_HOME}/build/cmake/android.toolchain.cmake",
        "ANDROID_ABI": "armeabi-v7a",
        "ANDROID_PLATFORM": "android-30",
        "ANDROID_STL": "c++_static",
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "host",
      "displayName": "Host Linux (test)",
      "generator": "Ninja",
      "binaryDir": "build/host",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    }
  ]
}
